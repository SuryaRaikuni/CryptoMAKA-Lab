/* =========================================================================
   CryptoMAKA Scyther Formal Verification Model: Post-Quantum ML-KEM-768
   Model: Three-Party Lattice-Based Key Encapsulation Mechanism (FIPS 203)
   Engine: Scyther v1.1.3+ (Trace Equivalence & Lattice Reduction)
   ========================================================================= */

usertype Nonce;
usertype TimeStamp;
usertype KEMCiphertext;
usertype SessionKey;

const pk: Function;
const encaps_c: Function;
const encaps_k: Function;
const shake256: Function;
const mac: Function;

/* Long-term symmetric authentication keys shared with Registration Center */
secret k_u: Function;
secret k_s: Function;
secret sk_s: Function;

protocol MLKEM768(U, S, RC)
{
    role U
    {
        fresh r: Nonce;
        fresh nu: Nonce;
        fresh ts1: TimeStamp;
        var ns: Nonce;
        var ts3, ts4: TimeStamp;

        /* Step 1: User encapsulates secret using S's public key pk(sk_s(S)) and sends M1 */
        send_1( U, S, (
            U, S,
            encaps_c(pk(sk_s(S)), r),
            nu,
            mac((U, S, encaps_c(pk(sk_s(S)), r), nu), k_u(U, RC)),
            ts1
        ) );

        /* Step 4: User receives ticket from RC and confirmation MAC from S */
        recv_4( S, U, (
            { S, encaps_c(pk(sk_s(S)), r), ns }k_u(U, RC),
            mac((S, shake256(encaps_k(pk(sk_s(S)), r), nu, ns), ts4), shake256(encaps_k(pk(sk_s(S)), r), nu, ns)),
            ts4
        ) );

        /* Secrecy and Authentication Claims */
        claim(U, Secret, shake256(encaps_k(pk(sk_s(S)), r), nu, ns));
        claim(U, Nisynch);
        claim(U, Niagree);
        claim(U, Alive);
        claim(U, Weakagree);
    }

    role S
    {
        fresh ns: Nonce;
        fresh ts2, ts4: TimeStamp;
        var r: Nonce;
        var nu: Nonce;
        var ts1, ts3: TimeStamp;

        /* Step 1: S receives M1 from U */
        recv_1( U, S, (
            U, S,
            encaps_c(pk(sk_s(S)), r),
            nu,
            mac((U, S, encaps_c(pk(sk_s(S)), r), nu), k_u(U, RC)),
            ts1
        ) );

        /* Step 2: S forwards M2 to RC */
        send_2( S, RC, (
            (
                U, S,
                encaps_c(pk(sk_s(S)), r),
                nu,
                mac((U, S, encaps_c(pk(sk_s(S)), r), nu), k_u(U, RC)),
                ts1
            ),
            S,
            ns,
            mac((S, U, encaps_c(pk(sk_s(S)), r), ns), k_s(S, RC)),
            ts2
        ) );

        /* Step 3: S receives tickets from RC */
        recv_3( RC, S, (
            { U, encaps_c(pk(sk_s(S)), r), nu }k_s(S, RC),
            { S, encaps_c(pk(sk_s(S)), r), ns }k_u(U, RC),
            ts3
        ) );

        /* Step 4: S decapsulates shared secret, derives SK, sends M4 to U */
        send_4( S, U, (
            { S, encaps_c(pk(sk_s(S)), r), ns }k_u(U, RC),
            mac((S, shake256(encaps_k(pk(sk_s(S)), r), nu, ns), ts4), shake256(encaps_k(pk(sk_s(S)), r), nu, ns)),
            ts4
        ) );

        /* Secrecy and Authentication Claims */
        claim(S, Secret, shake256(encaps_k(pk(sk_s(S)), r), nu, ns));
        claim(S, Nisynch);
        claim(S, Niagree);
        claim(S, Alive);
    }

    role RC
    {
        fresh ts3: TimeStamp;
        var r: Nonce;
        var nu, ns: Nonce;
        var ts1, ts2: TimeStamp;

        /* Step 2: RC receives M2 containing M1 and Cloud authenticator */
        recv_2( S, RC, (
            (
                U, S,
                encaps_c(pk(sk_s(S)), r),
                nu,
                mac((U, S, encaps_c(pk(sk_s(S)), r), nu), k_u(U, RC)),
                ts1
            ),
            S,
            ns,
            mac((S, U, encaps_c(pk(sk_s(S)), r), ns), k_s(S, RC)),
            ts2
        ) );

        /* Step 3: RC sends encrypted tickets for U and S */
        send_3( RC, S, (
            { U, encaps_c(pk(sk_s(S)), r), nu }k_s(S, RC),
            { S, encaps_c(pk(sk_s(S)), r), ns }k_u(U, RC),
            ts3
        ) );

        /* RC Authentication Claims */
        claim(RC, Nisynch);
        claim(RC, Niagree);
    }
}
